<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional Pro fallback service. Normal Cloudflare OAuth delivery is independent. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>uk.co.ukaq.news-email</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__MEDIA_REPO__/local/news-email/run.sh</string></array>
  <key>WorkingDirectory</key><string>__MEDIA_REPO__</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__PRIVATE_LOG_DIRECTORY__/news-email.log</string>
  <key>StandardErrorPath</key><string>__PRIVATE_LOG_DIRECTORY__/news-email.log</string>
</dict></plist>
