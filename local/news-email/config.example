# Optional fallback only; normal direct Cloudflare OAuth delivery needs no Pro.
# Names only / non-secret defaults. Set actual credentials in the Pro's ignored .env.
# Username also has a separate managed Worker-secret deployment; App Password is local-only.
GOOGLE_SMTP_USERNAME=
GOOGLE_SMTP_APP_PASSWORD=
NEWS_EMAIL_SENDER_SECRET=
NEWS_EMAIL_SITE_ORIGIN=
NEWS_EMAIL_PUBLIC_API_ORIGIN=
NEWS_EMAIL_RECEIPTS_PATH=/REPLACE_PRIVATE_STATE_DIRECTORY/news-email-receipts.sqlite3
NEWS_EMAIL_PORT=8025


# Reuse this environment’s existing IngestDB source; required for final recipient checks.
SUPABASE_URL=
SB_SECRET_KEY=
