{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uk-aq-media-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../media-public/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "MEDIA_DB",
      "database_name": "uk-aq-media",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_IMAGES",
      "bucket_name": "uk-aq-media-images"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "MEDIA_EMAIL_QUEUE", "queue": "uk-aq-media-email" },
      {
        "binding": "MEDIA_BLUESKY_QUEUE",
        "queue": "uk-aq-media-bluesky"
      },
      {
        "binding": "MEDIA_FACEBOOK_QUEUE",
        "queue": "uk-aq-media-facebook"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "secrets": {
    "required": [
      "UK_AQ_MEDIA_ADMIN_TOKEN"
    ]
  },
  "vars": {
    "MEDIA_AI_DAILY_NEURON_BUDGET": 8000,
    "MEDIA_AI_ACCOUNT_FREE_NEURONS_PER_DAY": 10000,
    "MEDIA_AI_MAX_TITLES_PER_REQUEST": 5,
    "MEDIA_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
