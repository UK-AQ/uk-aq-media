// Configuration only: replace the all-zero D1 ID after manual resource creation.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uk-aq-media-public",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "MEDIA_DB",
      "database_name": "uk-aq-media",
      "database_id": "75b39d56-a8e2-48dc-9208-7ac0d199219c",
      "migrations_dir": "../../migrations"
    }
  ]
}
