{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uk-aq-media-discovery-scheduled-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "MEDIA_DB",
      "database_name": "uk-aq-media",
      "database_id": "75b39d56-a8e2-48dc-9208-7ac0d199219c",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MEDIA_DISCOVERY_QUEUE",
        "queue": "uk-aq-media-discovery-scheduled-test"
      }
    ]
  }
}
