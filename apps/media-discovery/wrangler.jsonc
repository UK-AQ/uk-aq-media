// Configuration only: replace the all-zero D1 ID after manual resource creation.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uk-aq-media-discovery",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "MEDIA_DB",
      "database_name": "uk-aq-media",
      "database_id": "75b39d56-a8e2-48dc-9208-7ac0d199219c",
      "migrations_dir": "../../migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "MEDIA_DISCOVERY_QUEUE",
        "queue": "uk-aq-media-discovery"
      }
    ],
    "consumers": [
      {
        "queue": "uk-aq-media-discovery",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "retry_delay": 300
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "MEDIA_AI_MAX_CALLS_PER_RUN": 0,
    "MEDIA_AI_MODEL": ""
  }
}
