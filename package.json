{
  "name": "uk-aq-media",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "types": "node scripts/worker-tools.mjs types",
    "build": "node scripts/worker-tools.mjs build",
    "seed:check": "tsx scripts/source-seed.ts --check",
    "ai:check": "tsx scripts/display-title-ai-accounting-check.ts",
    "guardian-image:check": "tsx scripts/guardian-image-quality-check.ts",
    "article-head:check": "tsx scripts/article-head-metadata-check.ts",
    "publisher-rss:check": "tsx scripts/publisher-rss-discovery-check.ts",
    "possible-duplicate:check": "tsx scripts/possible-duplicate-check.ts",
    "dsawsp:check": "tsx scripts/dsawsp-discovery-check.ts",
    "caws:check": "tsx scripts/caws-discovery-check.ts",
    "remote-preview-image:check": "tsx scripts/remote-preview-image-check.ts",
    "local-image:check": "tsx scripts/local-image-check.ts",
    "image-policy-admin:check": "tsx scripts/image-policy-admin-check.ts",
    "admin-metadata-provider:check": "tsx scripts/admin-metadata-provider-check.ts",
    "homepage-latest-six:check": "tsx scripts/homepage-latest-six-check.ts",
    "public-feed-cursor:check": "tsx scripts/public-feed-cursor-check.ts",
    "gdelt:check": "tsx scripts/gdelt-web-ngrams-check.ts",
    "bluesky:check": "tsx scripts/bluesky-publication-check.ts",
    "facebook:check": "tsx scripts/facebook-provider-check.ts",
    "news-email:check": "tsx scripts/news-email-corrections-check.ts",
    "gdelt:run": "tsx scripts/gdelt-web-ngrams-batch.ts",
    "seed:generate": "tsx scripts/source-seed.ts",
    "check": "npm run seed:check && npm run ai:check && npm run guardian-image:check && npm run article-head:check && npm run publisher-rss:check && npm run possible-duplicate:check && npm run dsawsp:check && npm run caws:check && npm run remote-preview-image:check && npm run local-image:check && npm run image-policy-admin:check && npm run admin-metadata-provider:check && npm run homepage-latest-six:check && npm run public-feed-cursor:check && npm run gdelt:check && npm run bluesky:check && npm run facebook:check && npm run news-email:check && npm run typecheck && npm run build",
    "research-news:live-check": "tsx scripts/research-news-live-feed-check.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "4.132.0"
  }
}
